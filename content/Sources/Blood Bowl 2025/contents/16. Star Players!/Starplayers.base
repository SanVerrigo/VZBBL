filters:
  and:
    - file.tags.contains("starplayer")
formulas:
  File-name-as-link: concat("[[", file.name, "]]")
  Filename-as-Link: '"[[" + file.name + "]]"'
properties:
  formula.Filename-as-Link:
    displayName: Имя
views:
  - type: table
    name: Table
    order:
      - formula.Filename-as-Link
      - cost
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: Badlands Brawl
    filters:
      and:
        - leagues.containsAny(link("Badlands Brawl"), "any")
        - or:
            - note["leagues exception"].isEmpty()
            - '!note["leagues exception"].containsAny(link("Badlands Brawl"))'
    order:
      - formula.Filename-as-Link
      - cost
  - type: table
    name: Chaos Clash
    filters:
      and:
        - leagues.containsAny("any", link("Chaos Clash"))
        - or:
            - note["leagues exception"].isEmpty()
            - '!note["leagues exception"].containsAny(link("Chaos Clash"))'
    order:
      - formula.Filename-as-Link
      - cost
